#!/usr/bin/env bash

# Use printf instead of echo -e for better cross-platform color support
RED='\033[0;31m'
NC='\033[0m'

# Get current branch name
branch_name=$(git rev-parse --abbrev-ref HEAD)

# Space-separated string (works more reliably across different Bash versions than arrays)
PROTECTED_BRANCHES=" develop main master "

# Check if the current branch name exists within the protected string
if [[ $PROTECTED_BRANCHES =~ " $branch_name " ]]; then
    printf "${RED}Pushing to '%s' is not allowed! Please create a merge request.${NC}\n" "$branch_name"
    exit 1
fi

printf "Push is allowed to '%s', continuing...\n" "$branch_name"
exit 0
