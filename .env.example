# =============================================================================
# Environment Variables Configuration
# =============================================================================
# Copy this file to .env.local for local development
# NEVER commit .env.local to version control (it contains secrets)
#
# For different environments, use:
#   - .env.local          - Local development (overrides all others, gitignored)
#   - .env.development    - Development environment
#   - .env.production     - Production environment
#   - .env.test           - Testing environment
#
# Learn more: https://nextjs.org/docs/basic-features/environment-variables
# =============================================================================

# -----------------------------------------------------------------------------
# PUBLIC VARIABLES (exposed to browser)
# -----------------------------------------------------------------------------
# These variables are prefixed with NEXT_PUBLIC_ and will be exposed to the
# browser. They are embedded in the JavaScript bundle at build time.
#
# ⚠️  SECURITY WARNING: Never store secrets or sensitive data in these variables!
# -----------------------------------------------------------------------------

# The public URL of your application (used for links, redirects, etc.)
NEXT_PUBLIC_URL=http://localhost:3000

# The API endpoint for your backend service
# Used for making API calls from the browser
NEXT_PUBLIC_API_ENDPOINT=http://localhost:8080/api/v1

# -----------------------------------------------------------------------------
# SERVER VARIABLES (server-side only)
# -----------------------------------------------------------------------------
# These variables are ONLY available on the server side and will NOT be exposed
# to the browser. They are loaded at runtime for each request.
#
# ✅ GOOD: Store secrets, API keys, and sensitive data here
# -----------------------------------------------------------------------------

# NextAuth Configuration
# See: https://next-auth.js.org/configuration/options

# The full URL to your Next.js application (including protocol)
# Used by NextAuth for OAuth callbacks and session management
# Examples:
#   - Local: http://localhost:3000
#   - Production: https://your-domain.com
NEXTAUTH_URL=http://localhost:3000

# Secret key used to encrypt JWT tokens and sessions
# ⚠️  REQUIRED: Must be at least 32 characters long
# ⚠️  IMPORTANT: Use different values for dev/staging/production
#
# Generate a secure secret with:
#   openssl rand -base64 32
#
# Or use an online generator (ensure it's cryptographically secure):
#   https://generate-secret.vercel.app/32
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# -----------------------------------------------------------------------------
# NEXT.JS CONFIGURATION
# -----------------------------------------------------------------------------

# Node environment (affects build optimizations and error handling)
# - development: Detailed error messages, hot reloading
# - production: Optimized builds, minified code
# - test: Testing-specific optimizations
NODE_ENV=development

# =============================================================================
# CI/CD CONFIGURATION (GitHub Actions)
# =============================================================================
# When deploying with GitHub Actions, configure these in your repository:
#
# 1. GitHub Secrets (Settings → Secrets and variables → Actions):
#    - NEXTAUTH_SECRET: Generate with `openssl rand -base64 32`
#
# 2. GitHub Variables (Settings → Secrets and variables → Actions → Variables):
#    - NEXTAUTH_URL: Your app's URL (e.g., https://your-domain.com)
#    - NEXT_PUBLIC_URL: Same as NEXTAUTH_URL
#    - NEXT_PUBLIC_API_ENDPOINT: Your API endpoint
#
# 3. GitHub Environments (Settings → Environments):
#    Create separate environments for dev, staging, and production with
#    their own variables and secrets for proper separation.
#
# Example configuration:
#   Development:
#     - NEXTAUTH_URL=http://localhost:3000
#     - NEXT_PUBLIC_API_ENDPOINT=http://localhost:8080/api/v1
#
#   Staging:
#     - NEXTAUTH_URL=https://staging.your-domain.com
#     - NEXT_PUBLIC_API_ENDPOINT=https://api-staging.your-domain.com/v1
#
#   Production:
#     - NEXTAUTH_URL=https://your-domain.com
#     - NEXT_PUBLIC_API_ENDPOINT=https://api.your-domain.com/v1
# =============================================================================

# =============================================================================
# BUILD-TIME vs RUNTIME VARIABLES
# =============================================================================
# Build-time variables (NEXT_PUBLIC_*):
#   - Embedded in the JavaScript bundle during `next build`
#   - Available in both server and client code
#   - Cannot be changed without rebuilding
#   - Use for: Public URLs, API endpoints, feature flags
#
# Runtime variables (no NEXT_PUBLIC_ prefix):
#   - Loaded on the server for each request
#   - Only available in server-side code
#   - Can be changed without rebuilding
#   - Use for: Secrets, database URLs, API keys
# =============================================================================

# =============================================================================
# VALIDATION
# =============================================================================
# Environment variables are automatically validated by @t3-oss/env-nextjs
# using Zod schemas (see src/shared/lib/env/env.ts).
#
# The build will fail with clear error messages if required variables are
# missing or invalid. No manual validation script needed!
#
# Example error if NEXTAUTH_SECRET is missing:
#   ❌ Invalid environment variables: Missing secret: NEXTAUTH_SECRET
# =============================================================================
